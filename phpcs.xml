<?xml version="1.0"?>
<ruleset name="plugin">
    <arg name="cache" value=".phpcs.cache"/>
    <arg value="nps"/>

    <file>src/</file>
    <file>tests/</file>
    <!-- Declares Cake\View\HtmlStringable for CakePHP versions without it. -->
    <exclude-pattern>tests/Fixture/html_stringable_shim.php</exclude-pattern>

    <rule ref="PhpCollective"/>
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
    <rule ref="PhpCollective.Classes.ClassFileName.NoMatch"/>
</ruleset>
