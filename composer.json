{
    "name": "dereuromark/cakephp-menu",
    "description": "Composable menu builder and renderer for CakePHP",
    "type": "cakephp-plugin",
    "keywords": [
        "cakephp",
        "plugin",
        "menu",
        "navigation",
        "view",
        "helper"
    ],
    "license": "MIT",
    "homepage": "https://github.com/dereuromark/cakephp-menu",
    "support": {
        "issues": "https://github.com/dereuromark/cakephp-menu/issues",
        "source": "https://github.com/dereuromark/cakephp-menu",
        "docs": "https://github.com/dereuromark/cakephp-menu/wiki"
    },
    "authors": [
        {
            "name": "Mark Scherer",
            "homepage": "https://www.dereuromark.de",
            "role": "Maintainer"
        },
        {
            "name": "Florian Krämer",
            "homepage": "https://github.com/burzum/",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.1 || ^13.0",
        "php-collective/code-sniffer": "dev-master",
        "phpstan/phpstan": "^2.1"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Menu\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Menu\\Test\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@stan",
            "@test"
        ],
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-clover=coverage.xml",
        "cs-check": "phpcs --colors --parallel=16",
        "cs-fix": "phpcbf --colors --parallel=16",
        "stan": "phpstan analyze",
        "stan-setup": "cp composer.json composer.backup && composer require --dev phpstan/phpstan:^2.0.0 && mv composer.backup composer.json"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
